# The Leash: every environment variable, with defaults. No real values here.
# Next (`npm run dev`) reads .env.local. The tsx scripts (provision, e2e) read
# only the shell environment, so export variables or prefix the command.

# --- cluster: devnet or localnet ONLY (there is no mainnet value) ---
LEASH_CLUSTER=devnet
# Optional RPC override, e.g. a Helius devnet URL. The app checks the RPC's
# genesis hash and refuses mainnet. Credentials in the URL are never written
# to deployments/*.json or sent to the browser.
# LEASH_RPC_URL=https://api.devnet.solana.com

# --- brain: Groq, any OpenAI-compatible provider, or none (scripted brain) ---
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# LEASH_LLM_BASE_URL=https://api.openai.com/v1
# LEASH_LLM_API_KEY=
# LEASH_LLM_MODEL=gpt-4o-mini

# --- storage: unset = .data/attempts.jsonl locally, in-memory on Vercel ---
KV_REST_API_URL=
KV_REST_API_TOKEN=
# LEASH_DATA_FILE=.data/attempts.jsonl

# --- serverless secrets (locally these come from .keys/ and deployments/) ---
# JSON byte array of .keys/agent.json. Server-only. Never prefix with NEXT_PUBLIC_.
# LEASH_AGENT_SECRET=
# Contents of deployments/devnet.json (optional; the file is bundled).
# LEASH_DEPLOYMENT_JSON=

# --- abuse and fee controls ---
# LEASH_RL_PER_MIN=6
# LEASH_RL_PER_DAY=120
# Random secret for hashing IPs. Set it on any public deployment.
# LEASH_RL_SALT=
# Global cap on forced on-chain reverts per UTC day (each costs ~5,000 lamports).
# LEASH_FORCE_PER_DAY=2000
# 0 = never force-submit jailbroken payments (kill switch).
# LEASH_FORCE_ONCHAIN=1

# --- site ---
# Absolute URL for OG cards. The only NEXT_PUBLIC_ variable; it is public.
# NEXT_PUBLIC_SITE_URL=https://the-leash.example

# --- provision script only (scripts/provision-devnet.ts) ---
# LEASH_MAX_PER_TX=5
# LEASH_TOTAL_CAP=1000
# LEASH_VAULT_FUND=1000
# LEASH_MANDATE_DAYS=90
# LEASH_VENDOR_NAME=Kibble Co.
# LEASH_AGENT_SOL=0.5

# --- local validator script only ---
# Path to a local `anchor build` of the Capline program (else dumped from devnet).
# CAPLINE_SO=
