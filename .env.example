# --- cluster (devnet or localnet ONLY; there is no mainnet switch) ---
LEASH_CLUSTER=devnet
# LEASH_RPC_URL=https://api.devnet.solana.com   # optional, e.g. a Helius devnet URL

# --- brain (any one; none = scripted fallback brain) ---
GROQ_API_KEY=
# LEASH_LLM_MODEL=llama-3.3-70b-versatile
# Any OpenAI-compatible provider instead of Groq:
# LEASH_LLM_BASE_URL=https://api.openai.com/v1
# LEASH_LLM_API_KEY=
# LEASH_LLM_MODEL=gpt-4o-mini

# --- storage (unset = .data/attempts.jsonl locally, in-memory on Vercel) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- serverless secrets (locally these come from .keys/ and deployments/) ---
# LEASH_AGENT_SECRET=[12,34,...]          # JSON byte array of .keys/agent.json
# LEASH_DEPLOYMENT_JSON={...}              # contents of deployments/devnet.json (optional; file is bundled)

# --- knobs ---
# LEASH_RL_PER_MIN=6
# LEASH_RL_PER_DAY=120
# LEASH_RL_SALT=change-me
# LEASH_FORCE_ONCHAIN=1                    # 0 = skip the forced on-chain revert (saves fees)
# NEXT_PUBLIC_SITE_URL=https://the-leash.example   # absolute URL for OG cards
